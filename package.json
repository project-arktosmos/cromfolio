{
	"name": "synaxis",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tauri dev",
		"dev:frontend": "pnpm generate && vite dev",
		"dev:qq": "node scripts/generate-qq-locale.js",
		"build": "tauri build",
		"build:frontend": "pnpm generate && vite build",
		"generate": "node scripts/generate-admin-menu.js && node scripts/generate-game-menu.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@tauri-apps/cli": "^2.5.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.2.8",
		"@vitest/coverage-v8": "4.0.6",
		"@vitest/ui": "^4.0.6",
		"daisyui": "^5.0.50",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"happy-dom": "^20.0.10",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vitest": "^4.0.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.9",
		"@tauri-apps/api": "^2.5.0",
		"trystero": "^0.22.0",
		"@types/three": "^0.182.0",
		"audiomotion-analyzer": "^4.5.4",
		"classnames": "^2.5.1",
		"meyda": "^5.6.3",
		"svelte-i18n": "^4.0.1",
		"three": "^0.182.0",
		"web-audio-beat-detector": "^8.2.34"
	}
}
