{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Synaxis",
	"version": "0.1.0",
	"identifier": "com.arktosmos.synaxis",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:8086",
		"beforeDevCommand": "pnpm dev:frontend",
		"beforeBuildCommand": "pnpm build:frontend"
	},
	"app": {
		"windows": [
			{
				"title": "Synaxis",
				"width": 1920,
				"height": 1080,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": ["$APPDATA/**", "$APPDATA"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": ["../app.db"],
		"windows": {
			"wix": {
				"language": "en-US"
			}
		},
		"macOS": {
			"minimumSystemVersion": "10.13"
		}
	}
}
