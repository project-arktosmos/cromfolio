{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Default capability enabling core functionality",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:event:default",
		"core:event:allow-listen",
		"core:event:allow-emit",
		"shell:allow-open",
		"fs:default",
		"fs:allow-read-text-file",
		"fs:read-all",
		"store:default",
		"os:default",
		"log:default",
		"dialog:default",
		{
			"identifier": "http:default",
			"allow": [{ "url": "https://api.telegram.org/*" }, { "url": "https://stickers.wiki/*" }]
		}
	]
}
